# ==============================================================================
# Agro-Meteorological Weather Intelligence Backend (SIH 26074)
# Configuration Environment Variables
# ==============================================================================

# Application Settings
APP_NAME="GraminKrishi-Mausam-Intelligence"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=dev_insecure_secret_key_change_in_production_min_32_bytes_long

# Server Host and Port
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# CORS Configuration (comma-separated list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

# Database & PostGIS Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agri_weather_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agri_weather_db

# GIS & Spatial Configuration
# Default Spatial Reference System (EPSG:4326 for WGS84 coordinates)
DEFAULT_SRID=4326
PROJECTED_SRID=3857
# Grid resolution in km for high-res downscaled weather raster
TARGET_GRID_RESOLUTION_KM=1.0

# Weather Data Ingestion (Placeholders for official IMD / NCMRWF / Open APIs)
IMD_API_BASE_URL=https://placeholder-imd-api.gov.in/v1
IMD_API_KEY=
WEATHER_INGESTION_INTERVAL_MINUTES=180

# ML Downscaling Settings
MODEL_ARTIFACTS_DIR=models/
DEFAULT_DOWNSCALING_ALGORITHM=xgboost
USE_TERRAIN_CORRECTION=True

# Agro-Advisory Engine Settings
ADVISORY_MIN_CONFIDENCE_THRESHOLD=0.75
CROPMASK_VALIDATION_ENABLED=True

# Logging
LOG_LEVEL=INFO
