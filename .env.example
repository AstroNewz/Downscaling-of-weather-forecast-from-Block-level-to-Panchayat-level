# ==============================================================================
# SIH 26074: AgroWeather Downscaling - Environment Configuration Template
# Copy this file to backend/.env and frontend/.env (or root .env if using Docker)
# NEVER commit actual secrets or production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------

# Application Settings
APP_NAME="GraminKrishi-Mausam-Intelligence"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=dev_insecure_secret_key_change_in_production_min_32_bytes_long

# Server Host & Port
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# CORS Allowed Origins (JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:5173","http://127.0.0.1:8000"]

# PostgreSQL & PostGIS Database Settings
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agri_weather_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agri_weather_db

# GIS & Spatial Reference Systems
# EPSG:4326 for WGS84 Geographic Output
DEFAULT_SRID=4326
# Dynamic local UTM projection used for metric distance & area calculation (1000m grid)
PROJECTED_SRID=3857
TARGET_GRID_RESOLUTION_KM=1.0

# Weather Ingestion Provider Settings (IMD / NCMRWF / Open-Meteo)
IMD_API_BASE_URL=https://placeholder-imd-api.gov.in/v1
IMD_API_KEY=
WEATHER_INGESTION_INTERVAL_MINUTES=180

# Machine Learning Downscaling Settings
MODEL_ARTIFACTS_DIR=models/
DEFAULT_DOWNSCALING_ALGORITHM=xgboost
USE_TERRAIN_CORRECTION=True

# Agro-Advisory Engine Settings
ADVISORY_MIN_CONFIDENCE_THRESHOLD=0.75
CROPMASK_VALIDATION_ENABLED=True

# Logging
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
